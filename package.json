{
  "name": "universus-lifetracker",
  "private": true,
  "version": "1.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "test": "node --test tests/*.test.js",
    "check": "npm run lint && npm test && npm run build",
    "prepare:native": "npm run check && cap copy ios && cap copy android",
    "release:check": "node scripts/release-check.mjs",
    "prepare:android": "npm run check && cap sync android",
    "build:web": "vite build --base=/Momentum/play/ --outDir=work/web-dist && node scripts/build-web-worker.mjs"
  },
  "dependencies": {
    "@capacitor-community/keep-awake": "^8.0.0",
    "@capacitor/android": "^8.0.0",
    "@capacitor/app": "^8.0.0",
    "@capacitor/core": "^8.0.0",
    "@capacitor/haptics": "^8.0.0",
    "@capacitor/ios": "^8.0.0",
    "@capacitor/screen-orientation": "^8.0.0",
    "@capacitor/splash-screen": "^8.0.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/react": "^19.2.5",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.13.0",
    "vite": "^8.3.5",
    "@capacitor/cli": "^8.0.0"
  },
  "overrides": {
    "xcode": {
      "uuid": "^11.1.1"
    }
  }
}
